{
  "name": "blobocracy",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:level": "vitest run --mode slow",
    "typecheck": "tsc -p packages/shared && tsc -p packages/sim && tsc -p packages/client",
    "dev:server": "tsx watch packages/sim/src/main.ts",
    "dev:client": "vite packages/client",
    "dev": "node tools/dev.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
